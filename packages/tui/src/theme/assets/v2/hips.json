    "text": {
      "action": {
        "primary": {
          "$focused": "$hue.neutral.900"
        },
        "destructive": {
          "base": "$hue.neutral.900"
        }
      }
    },
    "border": {
      "base": "#9FB6C9"
    },
    "scrollbar": {
      "base": "#9FB6C9"
    },
    "diff": {
      "background": {
        "added": "#E2F3E0",
        "removed": "#FBE7EB",
        "context": "$hue.neutral.700"
      },
      "lineNumber": {
        "text": "#4A6884",
        "background": {
          "added": "#D3EBD0",
